import sys
import matplotlib.pyplot as plt
import numpy as np

plt.ion()
fig = plt.figure(figsize=(5,5))
ax = plt.subplot(111, polar=True)

ax.set_theta_zero_location("N")
ax.set_theta_direction(-1)
ax.set_ylim(0, 1)
ax.set_axis_off()

needle, = ax.plot([0, 0], [0, 1], linewidth=3, color="red")

fig.canvas.draw()
fig.canvas.flush_events()

for line in sys.stdin:
    if not line:
        continue

    try:
        # Expected format: "status magnitude agc angle"
        # Example: "19 17 255 800"
        angle = int(line)

        # Convert angle to radians
        angle_deg = (angle / 4095.0) * 360.0
        angle_rad = np.deg2rad(angle_deg)

        # Update needle
        needle.set_data([angle_rad, angle_rad], [0, 1])

        # Fast redraw
        fig.canvas.draw()
        fig.canvas.flush_events()

    except Exception:
        # Ignore malformed lines
        pass
